expression Map_AsignacionPusherFuente =
		let
			RutaFuente = RutaCarpetaData & "\BI - NUEVO.xlsx",
			Libro = Excel.Workbook(File.Contents(RutaFuente), null, true),
			Coincidencias = Table.SelectRows(Libro, each [Item] = "Asignacion_PUSHER" and [Kind] = "Sheet"),
			Origen =
				if Table.RowCount(Coincidencias) = 1
				then Coincidencias{0}[Data]
				else error "No se encontro una unica hoja Asignacion_PUSHER.",
			Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
			ColumnasRequeridas = {"PUSHER", "DESCRIPCION_ALTAS", "DESCRIPCION2_ALTAS"},
			ColumnasFaltantes = List.Difference(ColumnasRequeridas, Table.ColumnNames(Encabezados)),
			ConEsquemaValido =
				if List.IsEmpty(ColumnasFaltantes)
				then Table.SelectColumns(Encabezados, ColumnasRequeridas)
				else error "Faltan columnas obligatorias en Asignacion_PUSHER: " & Text.Combine(ColumnasFaltantes, ", "),
			Renombradas = Table.RenameColumns(ConEsquemaValido, {
				{"PUSHER", "PusherOrigen"},
				{"DESCRIPCION_ALTAS", "Descripcion"},
				{"DESCRIPCION2_ALTAS", "Descripcion2"}
			}),
			NormalizarTexto = (Valor as any) as nullable text =>
				if Valor = null then null
				else
					let Texto = Text.Upper(Text.Trim(Text.Clean(Text.From(Valor))))
					in if Texto = "" then null else Texto,
			Normalizadas = Table.TransformColumns(Renombradas, {
				{"PusherOrigen", NormalizarTexto, type nullable text},
				{"Descripcion", NormalizarTexto, type nullable text},
				{"Descripcion2", NormalizarTexto, type nullable text}
			}),
			FilasValidas = Table.SelectRows(Normalizadas, each [PusherOrigen] <> null and [Descripcion] <> null),
			AnclasPublicas = #table(
				type table [Descripcion = text, Pusher = text],
				{
					{"COS", "PUSHER 1"},
					{"ONE CONTACT", "PUSHER 2"},
					{"CONTACTMASTER BPO", "PUSHER 3"}
				}
			),
			ConAncla = Table.NestedJoin(FilasValidas, {"Descripcion"}, AnclasPublicas, {"Descripcion"}, "Ancla", JoinKind.LeftOuter),
			AnclaExpandida = Table.ExpandTableColumn(ConAncla, "Ancla", {"Pusher"}, {"PusherAncla"}),
			Grupos = Table.Group(AnclaExpandida, {"PusherOrigen"}, {{"Etiquetas", each List.Distinct(List.RemoveNulls([PusherAncla])), type list}}),
			GruposInvalidos = Table.SelectRows(Grupos, each List.Count([Etiquetas]) <> 1),
			MapaGrupos =
				if Table.RowCount(Grupos) = 3 and Table.IsEmpty(GruposInvalidos)
				then Table.AddColumn(Grupos, "Pusher", each [Etiquetas]{0}, type text)
				else error "La asignacion de grupos PUSHER no es univoca.",
			EtiquetasObtenidas = List.Sort(List.Distinct(Table.Column(MapaGrupos, "Pusher"))),
			MapaGruposValidado =
				if EtiquetasObtenidas = {"PUSHER 1", "PUSHER 2", "PUSHER 3"}
				then Table.SelectColumns(MapaGrupos, {"PusherOrigen", "Pusher"})
				else error "Asignacion_PUSHER no contiene las tres etiquetas publicas esperadas.",
			ConPusherPublico = Table.NestedJoin(FilasValidas, {"PusherOrigen"}, MapaGruposValidado, {"PusherOrigen"}, "MapaPusher", JoinKind.LeftOuter),
			PusherExpandido = Table.ExpandTableColumn(ConPusherPublico, "MapaPusher", {"Pusher"}, {"Pusher"}),
			// Nombre de la fuente conservado como etiqueta de presentacion (autorizado por negocio en R7).
			ConPusherNombre = Table.RenameColumns(PusherExpandido, {{"PusherOrigen", "PusherNombre"}}),
			SinDuplicados = Table.Distinct(ConPusherNombre),
			ConTipoRegla = Table.AddColumn(SinDuplicados, "TipoRegla", each if [Descripcion2] = null then "General" else "Especifica", type text),
			ConAliadoKey = Table.AddColumn(ConTipoRegla, "AliadoKey", each if [TipoRegla] = "Especifica" then [Descripcion] & "|" & [Descripcion2] else [Descripcion], type text),
			ReglasAgrupadas = Table.Group(ConAliadoKey, {"TipoRegla", "Descripcion", "Descripcion2"}, {{"CantidadPusher", each List.Count(List.Distinct([Pusher])), Int64.Type}}),
			Colisiones = Table.SelectRows(ReglasAgrupadas, each [CantidadPusher] <> 1),
			MapaValidado =
				if Table.IsEmpty(Colisiones)
				then Table.SelectColumns(ConAliadoKey, {"AliadoKey", "Descripcion", "Descripcion2", "Pusher", "PusherNombre", "TipoRegla"})
				else error "Existen reglas de asignacion PUSHER con clasificaciones diferentes.",
			Ordenado = Table.Sort(MapaValidado, {{"TipoRegla", Order.Ascending}, {"Descripcion", Order.Ascending}, {"Descripcion2", Order.Ascending}})
		in
			Ordenado
	lineageTag: ee4df56f-6f79-4701-976b-fac3ce43fdf9

	annotation PBI_ResultType = Table

