expression MatrizCalidad_Limpio =
		let
			Origen = Base_MatrizCalidad,
			EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
			NombresColumnaSinEspacios = Table.TransformColumnNames(EncabezadosPromovidos, Text.Trim),
			TextoLimpio = Table.TransformColumns(NombresColumnaSinEspacios, {}, each if _ is text then Text.Trim(Text.Clean(_)) else _),
			TimestampComoFechaHora = Table.TransformColumnTypes(TextoLimpio, {{"Timestamp", type datetime}}),
			ColumnaFechaAgregada = Table.AddColumn(TimestampComoFechaHora, "Fecha", each if [Timestamp] = null then null else Date.From([Timestamp]), type date),
			CallCenterNormalizado = Table.TransformColumns(ColumnaFechaAgregada, {{"CALL CENTER", each if _ = null then _ else Text.Trim(Text.Upper(_)), type text}})
		in
			CallCenterNormalizado
	lineageTag: 2203c06d-4742-4a85-be50-8fdc317fec69

	annotation PBI_ResultType = Table

