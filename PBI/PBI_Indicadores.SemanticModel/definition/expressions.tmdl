expression Base_AltasTeResuelve =
		let
			NombreArchivo = "Consolidado informe de Altas.xlsx",
			CarpetaFuente = RutaCarpetaData & "\Informe de Altas",
			RutaEsperada = CarpetaFuente & "\" & NombreArchivo,
			RutaValidada = if Ruta_Informe_Altas = RutaEsperada then Ruta_Informe_Altas else error "Ruta_Informe_Altas no corresponde al archivo comercial esperado dentro de RutaCarpetaData.",
			ArchivosCarpeta = Folder.Contents(CarpetaFuente),
			CoincidenciasArchivo = Table.SelectRows(ArchivosCarpeta, each [Name] = NombreArchivo),
			ArchivoFuente =
				if Table.RowCount(CoincidenciasArchivo) = 1
				then CoincidenciasArchivo{0}
				else error "No se encontro un unico archivo fuente para Base_AltasTeResuelve.",
			ContenidoArchivo = if RutaValidada <> null then ArchivoFuente[Content] else error "Ruta de fuente no valida.",
			FechaModificacionFuente = Record.Field(ArchivoFuente, "Date modified"),
			TamanoFuenteBytes = Int64.From(ArchivoFuente[Size]),
			HuellaFuenteOperativa = NombreArchivo & "|" & Text.From(TamanoFuenteBytes, "en-US") & "|" & DateTimeZone.ToText(DateTimeZone.From(FechaModificacionFuente), [Format="yyyy-MM-ddTHH:mm:ssK", Culture="en-US"]),
			Libro = Excel.Workbook(ContenidoArchivo, null, true),
			CoincidenciasInsumo2 = Table.SelectRows(Libro, each [Item] = "Insumo2" and [Kind] = "Table"),
			TablaInsumo2 =
				if Table.RowCount(CoincidenciasInsumo2) = 1
				then CoincidenciasInsumo2{0}[Data]
				else error "No se encontro una unica tabla formal Insumo2 en el libro de altas.",
			ColumnasRequeridas = {"ALTAS", "DESCRIPCION", "FECHA_ALTA", "MES"},
			ColumnasFaltantes = List.Difference(ColumnasRequeridas, Table.ColumnNames(TablaInsumo2)),
			DatosConEsquemaValido =
				if List.IsEmpty(ColumnasFaltantes)
				then TablaInsumo2
				else error "Faltan columnas obligatorias en Insumo2: " & Text.Combine(ColumnasFaltantes, ", "),
			FechasDisponibles = List.RemoveNulls(List.Transform(Table.Column(DatosConEsquemaValido, "FECHA_ALTA"), each try Date.From(_) otherwise try Date.FromText(Text.Trim(Text.Clean(Text.From(_))), [Culture="es-CO"]) otherwise null)),
			PeriodosDisponibles = List.Transform(FechasDisponibles, each Date.Year(_) * 100 + Date.Month(_)),
			DatosConCorteValido =
				if List.Contains(PeriodosDisponibles, Int64.From(Periodo_Corte_Comercial))
				then DatosConEsquemaValido
				else error "Periodo_Corte_Comercial no existe en Insumo2.",
			ConArchivoFuente = Table.AddColumn(DatosConCorteValido, "ArchivoFuente", each NombreArchivo, type text),
			ConObjetoFuente = Table.AddColumn(ConArchivoFuente, "ObjetoFuente", each "Insumo2", type text),
			ConRutaFuente = Table.AddColumn(ConObjetoFuente, "RutaFuente", each RutaValidada, type text),
			ConFechaModificacion = Table.AddColumn(ConRutaFuente, "FechaModificacionFuente", each FechaModificacionFuente),
			ConTamanoFuente = Table.AddColumn(ConFechaModificacion, "TamanoFuenteBytes", each TamanoFuenteBytes, Int64.Type),
			ConHuellaFuente = Table.AddColumn(ConTamanoFuente, "HuellaFuenteOperativa", each HuellaFuenteOperativa, type text),
			ConPeriodoCorte = Table.AddColumn(ConHuellaFuente, "PeriodoCorteConfigurado", each Int64.From(Periodo_Corte_Comercial), Int64.Type)
		in
			ConPeriodoCorte
	lineageTag: d2a235dc-60bf-40b2-a3b8-bccd57eaed3a

	annotation PBI_ResultType = Table

expression AltasTeResuelve_Limpio =
		let
			Origen = Base_AltasTeResuelve,
			SinColumnasSensibles = Table.RemoveColumns(Origen, {"JEFE", "ESPECIALISTA", "ASESOR"}, MissingField.Ignore),
			ConvertirEntero = (Valor as any) as nullable number =>
				if Valor = null then null
				else
					let
						ConversionDirecta = try Int64.From(Valor),
						ConversionTexto = if ConversionDirecta[HasError] then try Int64.From(Number.FromText(Text.Trim(Text.Clean(Text.From(Valor))), "es-CO")) else ConversionDirecta
					in
						if ConversionTexto[HasError] then null else ConversionTexto[Value],
			ConvertirFecha = (Valor as any) as nullable date =>
				if Valor = null then null
				else
					let
						ConversionDirecta = try Date.From(Valor),
						ConversionTexto = if ConversionDirecta[HasError] then try Date.FromText(Text.Trim(Text.Clean(Text.From(Valor))), [Culture="es-CO"]) else ConversionDirecta
					in
						if ConversionTexto[HasError] then null else ConversionTexto[Value],
			ConAltas = Table.AddColumn(SinColumnasSensibles, "Altas", each ConvertirEntero([ALTAS]), Int64.Type),
			ConFechaAlta = Table.AddColumn(ConAltas, "FechaAlta", each ConvertirFecha([FECHA_ALTA]), type date),
			ConMesFuente = Table.AddColumn(ConFechaAlta, "MesFuente", each ConvertirEntero([MES]), Int64.Type),
			ConDescripcion = Table.AddColumn(ConMesFuente, "Descripcion", each if [DESCRIPCION] = null then null else Text.Upper(Text.Trim(Text.Clean(Text.From([DESCRIPCION])))), type nullable text),
			ConDescripcion2 = Table.AddColumn(ConDescripcion, "Descripcion2", each if [DESCRIPCION2] = null then null else Text.Upper(Text.Trim(Text.Clean(Text.From([DESCRIPCION2])))), type nullable text),
			SinColumnasOrigenTipadas = Table.RemoveColumns(ConDescripcion2, {"ALTAS", "FECHA_ALTA", "MES", "DESCRIPCION", "DESCRIPCION2"}),
			NombresTecnicos = Table.RenameColumns(SinColumnasOrigenTipadas, {
				{"FECHA_ALTA - Copy.1", "FechaAltaCopia1"},
				{"DIVISION", "Division"},
				{"CANAL", "Canal"},
				{"CANAL2", "Canal2"},
				{"TIPO_PAQUETE", "TipoPaquete"},
				{"TIPO", "Tipo"},
				{"SUBTIPO", "Subtipo"},
				{"SERVICIO", "Servicio"},
				{"UNIDAD_NEGOCIO", "UnidadNegocio"}
			}, MissingField.Ignore),
			TiposTexto = Table.TransformColumnTypes(NombresTecnicos, {
				{"Division", type text},
				{"Canal", type text},
				{"Canal2", type text},
				{"TipoPaquete", type text},
				{"Descripcion2", type text},
				{"Tipo", type text},
				{"Subtipo", type text},
				{"Servicio", type text},
				{"UnidadNegocio", type text}
			}, "es-CO"),
			ReglasEspecificas = Table.SelectRows(Map_AsignacionPusherFuente, each [TipoRegla] = "Especifica"),
			ConReglaEspecifica = Table.NestedJoin(
				TiposTexto,
				{"Descripcion", "Descripcion2"},
				ReglasEspecificas,
				{"Descripcion", "Descripcion2"},
				"ReglaEspecifica",
				JoinKind.LeftOuter
			),
			ConAliadoKeyEspecifico = Table.ExpandTableColumn(ConReglaEspecifica, "ReglaEspecifica", {"AliadoKey"}, {"AliadoKeyEspecifico"}),
			ConAliadoKey = Table.AddColumn(ConAliadoKeyEspecifico, "AliadoKey", each if [AliadoKeyEspecifico] <> null then [AliadoKeyEspecifico] else [Descripcion], type nullable text),
			SinClaveAuxiliar = Table.RemoveColumns(ConAliadoKey, {"AliadoKeyEspecifico"}),
			ConMes = Table.AddColumn(SinClaveAuxiliar, "Mes", each if [FechaAlta] = null then null else Date.Year([FechaAlta]) * 100 + Date.Month([FechaAlta]), Int64.Type),
			ConMesCoincideFecha = Table.AddColumn(ConMes, "MesCoincideFecha", each [MesFuente] <> null and [Mes] <> null and [MesFuente] = [Mes], type logical),
			PeriodosValidos = List.RemoveNulls(Table.Column(ConMesCoincideFecha, "Mes")),
			MaximoPeriodoFuente = if List.IsEmpty(PeriodosValidos) then null else List.Max(PeriodosValidos),
			ConEstadoPeriodo = Table.AddColumn(ConMesCoincideFecha, "EstadoPeriodo", each
				if [Mes] = null then "Periodo invalido"
				else if [Mes] <= Int64.From(Periodo_Corte_Comercial) then "Cerrado"
				else if [Mes] = MaximoPeriodoFuente then "En curso"
				else "Posterior al corte sin validar", type text),
			ConEsPeriodoComparable = Table.AddColumn(ConEstadoPeriodo, "EsPeriodoComparable", each [Mes] <> null and [Mes] <= Int64.From(Periodo_Corte_Comercial), type logical),
			ConMotivoInvalidez = Table.AddColumn(ConEsPeriodoComparable, "MotivoInvalidez", each Text.Combine(List.RemoveNulls({
				if [Altas] = null then "Altas invalida" else if [Altas] < 0 then "Altas negativa" else null,
				if [FechaAlta] = null then "FechaAlta invalida" else null,
				if [Mes] = null then "Mes invalido" else null,
				if [Descripcion] = null or [Descripcion] = "" then "Descripcion vacia" else null
			}), "; "), type text),
			ConEstadoFila = Table.AddColumn(ConMotivoInvalidez, "EstadoFila", each if [MotivoInvalidez] = "" then "Valida" else "Invalida", type text),
			SumaAltasOrigen = List.Sum(List.RemoveNulls(List.Transform(Table.Column(SinColumnasSensibles, "ALTAS"), each ConvertirEntero(_)))),
			SumaAltasLimpia = List.Sum(List.RemoveNulls(Table.Column(ConEstadoFila, "Altas"))),
			FilasConciliadas =
				if Table.RowCount(SinColumnasSensibles) = Table.RowCount(ConEstadoFila)
				then ConEstadoFila
				else error "La limpieza altero el numero de filas de Base_AltasTeResuelve.",
			AltasConciliadas =
				if SumaAltasOrigen = SumaAltasLimpia
				then FilasConciliadas
				else error "La suma de Altas no concilia entre staging y limpieza."
		in
			AltasConciliadas
	lineageTag: cae52255-48c6-42e2-9932-e6efdc9121e7

	annotation PBI_ResultType = Table

expression Map_PusherAliado =
		#table(
			type table [Descripcion = text, Pusher = text],
			{
				{"MILLENIUM", "PUSHER 1"},
				{"VECTOR", "PUSHER 1"},
				{"INTELIGENCE BUSSINES RECOVERY COL", "PUSHER 1"},
				{"ASISTE ING", "PUSHER 1"},
				{"COS", "PUSHER 1"},
				{"CAV BOGOTA CENTRO MAYOR", "PUSHER 1"},
				{"AIB", "PUSHER 1"},
				{"BRM", "PUSHER 2"},
				{"CAV BOGOTA PLAZA IMPERIAL", "PUSHER 2"},
				{"CAPITALS TELECOM BPO", "PUSHER 2"},
				{"ONE CONTACT", "PUSHER 2"},
				{"INTERACTIVO", "PUSHER 2"},
				{"ATENTO", "PUSHER 2"},
				{"CAV BOGOTA PLAZA DE LAS AMERICAS", "PUSHER 2"},
				{"ALMAEXPERIENCE SAS", "PUSHER 2"},
				{"GNP", "PUSHER 2"}
			}
		)
	lineageTag: 4b582869-8c7c-4c90-9321-308de14e8c66

	annotation PBI_ResultType = Table

expression Control_Aliados_Sin_Clasificar =
		let
			FilasValidas = Table.SelectRows(AltasTeResuelve_Limpio, each [EstadoFila] = "Valida"),
			AltasPorAliado = Table.Group(FilasValidas, {"AliadoKey", "Descripcion"}, {{"CantidadAltas", each List.Sum([Altas]), Int64.Type}}),
			ConMapa = Table.NestedJoin(AltasPorAliado, {"AliadoKey"}, Map_AsignacionPusherFuente, {"AliadoKey"}, "Mapeo", JoinKind.LeftOuter),
			SinClasificar = Table.SelectRows(ConMapa, each Table.IsEmpty([Mapeo])),
			SinMapeoAnidado = Table.RemoveColumns(SinClasificar, {"Mapeo"}),
			ConEstadoClasificacion = Table.AddColumn(SinMapeoAnidado, "Estado_Clasificacion", each "Pendiente", type text),
			Ordenado = Table.Sort(ConEstadoClasificacion, {{"CantidadAltas", Order.Descending}, {"Descripcion", Order.Ascending}})
		in
			Ordenado
	lineageTag: 76ddfdca-7f63-479c-b48c-d9d0b5a403f1

	annotation PBI_ResultType = Table

expression Config_MetasComerciales =
		let
			RutaFuente = RutaCarpetaData & "\BI - NUEVO.xlsx",
			Libro = Excel.Workbook(File.Contents(RutaFuente), null, true),
			Coincidencias = Table.SelectRows(Libro, each [Item] = "Metas_Bonos" and [Kind] = "Sheet"),
			Origen =
				if Table.RowCount(Coincidencias) = 1
				then Coincidencias{0}[Data]
				else error "No se encontro una unica hoja Metas_Bonos.",
			Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
			ColumnasRequeridas = {"Año", "Mes", "PUSHER", "Aliado_BI", "Asesor_Equipo", "Tipo_Meta", "Meta_Ventas"},
			ColumnasFaltantes = List.Difference(ColumnasRequeridas, Table.ColumnNames(Encabezados)),
			ConEsquemaValido =
				if List.IsEmpty(ColumnasFaltantes)
				then Table.SelectColumns(Encabezados, ColumnasRequeridas)
				else error "Faltan columnas obligatorias en Metas_Bonos: " & Text.Combine(ColumnasFaltantes, ", "),
			NormalizarTexto = (Valor as any) as nullable text =>
				if Valor = null then null
				else
					let Texto = Text.Upper(Text.Trim(Text.Clean(Text.From(Valor))))
					in if Texto = "" then null else Texto,
			Renombradas = Table.RenameColumns(ConEsquemaValido, {
				{"Año", "Anio"},
				{"PUSHER", "PusherOrigen"},
				{"Aliado_BI", "Aliado"},
				{"Asesor_Equipo", "Nivel"},
				{"Tipo_Meta", "TipoMeta"},
				{"Meta_Ventas", "Meta"}
			}),
			Normalizadas = Table.TransformColumns(Renombradas, {
				{"Anio", each try Int64.From(_) otherwise null, Int64.Type},
				{"Mes", NormalizarTexto, type nullable text},
				{"PusherOrigen", NormalizarTexto, type nullable text},
				{"Aliado", NormalizarTexto, type nullable text},
				{"Nivel", NormalizarTexto, type nullable text},
				{"TipoMeta", NormalizarTexto, type nullable text},
				{"Meta", each try Int64.From(_) otherwise null, Int64.Type}
			}),
			FilasMeta = Table.SelectRows(Normalizadas, each [Anio] <> null and [Mes] <> null and [Aliado] <> null and [TipoMeta] = "META PARA BONO" and List.Contains({"CALL", "ESPECIALISTA", "ASESOR"}, [Nivel])),
			Meses = [ENERO = 1, FEBRERO = 2, MARZO = 3, ABRIL = 4, MAYO = 5, JUNIO = 6, JULIO = 7, AGOSTO = 8, SEPTIEMBRE = 9, OCTUBRE = 10, NOVIEMBRE = 11, DICIEMBRE = 12],
			ConAnioMes = Table.AddColumn(FilasMeta, "AnioMes", each
				let MesNumero = Record.FieldOrDefault(Meses, [Mes], null)
				in if MesNumero = null then error "Mes no reconocido en Metas_Bonos: " & [Mes] else [Anio] * 100 + MesNumero, Int64.Type),
			// Llave logica: Anio + Mes + PUSHER + Aliado + Asesor_Equipo + Tipo_Meta. Las filas ASESOR repetidas por incentivo colapsan aqui.
			Llaves = Table.Group(ConAnioMes, {"AnioMes", "PusherOrigen", "Aliado", "Nivel", "TipoMeta"}, {{"Metas", each List.Distinct(List.RemoveNulls([Meta])), type list}}),
			LlavesInvalidas = Table.SelectRows(Llaves, each List.Count([Metas]) <> 1),
			LlavesUnicas =
				if Table.IsEmpty(LlavesInvalidas)
				then Table.AddColumn(Llaves, "Meta", each [Metas]{0}, Int64.Type)
				else error "Metas_Bonos tiene llaves logicas con Meta_Ventas ausente o multiple.",
			Contextos = Table.Group(LlavesUnicas, {"AnioMes", "Aliado"}, {
				{"CantidadPusher", each List.Count(List.Distinct([PusherOrigen])), Int64.Type},
				{"MetaCall", each List.First(List.RemoveNulls(List.Transform(Table.ToRecords(_), (r) => if r[Nivel] = "CALL" then r[Meta] else null))), Int64.Type},
				{"MetaEspecialista", each List.First(List.RemoveNulls(List.Transform(Table.ToRecords(_), (r) => if r[Nivel] = "ESPECIALISTA" then r[Meta] else null))), Int64.Type},
				{"MetaAsesor", each List.First(List.RemoveNulls(List.Transform(Table.ToRecords(_), (r) => if r[Nivel] = "ASESOR" then r[Meta] else null))), Int64.Type}
			}),
			ContextosInvalidos = Table.SelectRows(Contextos, each [CantidadPusher] <> 1 or [MetaCall] = null or [MetaEspecialista] = null or [MetaCall] <> [MetaEspecialista]),
			ContextosValidos =
				if Table.IsEmpty(ContextosInvalidos)
				then Contextos
				else error "Metas_Bonos: contexto sin PUSHER unico o con CALL distinto de ESPECIALISTA.",
			// Suboperaciones gobernadas por R3: Aliado_BI coincide exactamente con DESCRIPCION2 de una regla especifica.
			ReglasEspecificas = Table.SelectRows(Map_AsignacionPusherFuente, each [TipoRegla] = "Especifica"),
			ConRegla = Table.NestedJoin(ContextosValidos, {"Aliado"}, ReglasEspecificas, {"Descripcion2"}, "Regla", JoinKind.LeftOuter),
			ReglaExpandida = Table.ExpandTableColumn(ConRegla, "Regla", {"AliadoKey", "Descripcion"}, {"AliadoKeyEspecifico", "DescripcionEspecifica"}),
			ConAliadoKey = Table.AddColumn(ReglaExpandida, "AliadoKey", each if [AliadoKeyEspecifico] <> null then [AliadoKeyEspecifico] else [Aliado], type text),
			ConDescripcion = Table.AddColumn(ConAliadoKey, "Descripcion", each if [DescripcionEspecifica] <> null then [DescripcionEspecifica] else [Aliado], type text),
			Final = Table.RenameColumns(Table.SelectColumns(ConDescripcion, {"AnioMes", "AliadoKey", "Descripcion", "MetaCall", "MetaAsesor"}), {{"MetaCall", "MetaAltas"}}),
			ClavesDuplicadas = Table.RowCount(Final) <> Table.RowCount(Table.Distinct(Table.SelectColumns(Final, {"AnioMes", "AliadoKey"})))
		in
			if ClavesDuplicadas then error "Metas_Bonos genera claves periodo-aliado duplicadas." else Final
	lineageTag: fe2344f9-761c-419a-8990-4bbe7561f9c7

