expression MatrizCalidad_Limpio =
		let
			Origen = Base_MatrizCalidad,
			EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
			NombresColumnaSinEspacios = Table.TransformColumnNames(EncabezadosPromovidos, Text.Trim),
			TextoLimpio = Table.TransformColumns(NombresColumnaSinEspacios, {}, each if _ is text then Text.Trim(Text.Clean(_)) else _),
			TimestampComoFechaHora = Table.TransformColumnTypes(TextoLimpio, {{"Timestamp", type datetime}}),
			ColumnaFechaAgregada = Table.AddColumn(TimestampComoFechaHora, "Fecha", each if [Timestamp] = null then null else Date.From([Timestamp]), type date),
			CallCenterNormalizado = Table.TransformColumns(ColumnaFechaAgregada, {{"CALL CENTER", each if _ = null then _ else Text.Trim(Text.Upper(_)), type text}})
		in
			CallCenterNormalizado
	lineageTag: 2203c06d-4742-4a85-be50-8fdc317fec69

	annotation PBI_ResultType = Table

expression SatisfaccionCapacitacion_Limpio =
		let
			Origen = Base_SatisfaccionCapacitacion,
			EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
			NombresColumnaSinEspacios = Table.TransformColumnNames(EncabezadosPromovidos, Text.Trim),
			TextoLimpio = Table.TransformColumns(NombresColumnaSinEspacios, {}, each if _ is text then Text.Trim(Text.Clean(_)) else _),
			TimestampComoFechaHora = Table.TransformColumns(TextoLimpio, {{"Timestamp", each
				if _ = null then null
				else if _ is datetime then _
				else if _ is date then DateTime.From(_)
				else if _ is number then DateTime.From(_)
				else if _ is text then
					let
						TextoTimestamp = Text.Trim(Text.Clean(_))
					in
						if TextoTimestamp = "" or Text.Length(TextoTimestamp) < 8
						then null
						else DateTime.FromText(TextoTimestamp, [Culture = "en-US"])
				else error "Tipo de Timestamp no soportado en SatisfaccionCapacitacion_Limpio",
				type nullable datetime}}),
			TimestampNormalizado = Table.TransformColumns(TimestampComoFechaHora, {{"Timestamp", each
				let
					FechaBase = if _ = null then null else Date.From(_),
					HoraBase = if _ = null then null else Time.From(_),
					FechaCorregida =
						if FechaBase <> null
							and Date.Year(FechaBase) = 2026
							and Date.Day(FechaBase) = 7
							and List.Contains({8, 9, 10}, Date.Month(FechaBase))
						then #date(Date.Year(FechaBase), Date.Day(FechaBase), Date.Month(FechaBase))
						else FechaBase
				in
					if FechaCorregida = null then null else #datetime(
						Date.Year(FechaCorregida),
						Date.Month(FechaCorregida),
						Date.Day(FechaCorregida),
						Time.Hour(HoraBase),
						Time.Minute(HoraBase),
						Time.Second(HoraBase)
					), type datetime}}),
			ColumnaFechaAgregada = Table.AddColumn(TimestampNormalizado, "Fecha", each if [Timestamp] = null then null else Date.From([Timestamp]), type date),
			CallCenterNormalizado = Table.TransformColumns(ColumnaFechaAgregada, {{"¿En qué call center trabajas?", each if _ = null then _ else Text.Trim(Text.Upper(_)), type text}})
		in
			CallCenterNormalizado
	lineageTag: fb62451f-5559-43e7-abae-9a5e9e016d2e

	annotation PBI_ResultType = Table

