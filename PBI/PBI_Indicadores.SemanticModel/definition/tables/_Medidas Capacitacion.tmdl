table '_Medidas Capacitacion'
	lineageTag: 37844e70-23b6-415d-8042-e3f845aa89cc

	measure 'Satisfaccion Promedio Capacitacion' = AVERAGE(Fact_SatisfaccionCapacitacion[SatisfaccionGeneral])
		formatString: 0.0
		lineageTag: 5e8cc843-ecb4-4ab4-b6a7-a0a94414a7c7

	measure 'Claridad Promedio Capacitacion' = AVERAGE(Fact_SatisfaccionCapacitacion[Claridad])
		formatString: 0.0
		lineageTag: f754d0e1-112f-436c-b46f-82166823f1fd

	measure 'Utilidad Promedio Capacitacion' = AVERAGE(Fact_SatisfaccionCapacitacion[Utilidad])
		formatString: 0.0
		lineageTag: 7bd5f9d3-7705-4fea-8647-9875715a6b53

	measure 'Dinamismo Promedio Capacitacion' = AVERAGE(Fact_SatisfaccionCapacitacion[Dinamismo])
		formatString: 0.0
		lineageTag: 742ac368-d3dd-4830-b7bd-f1db7632e926

	measure 'Indice Global Capacitacion' = DIVIDE([Satisfaccion Promedio Capacitacion] + [Claridad Promedio Capacitacion] + [Utilidad Promedio Capacitacion] + [Dinamismo Promedio Capacitacion], 4)
		formatString: 0.0
		lineageTag: 2418a74a-e9ca-47be-8c4c-ab922ffa9a0a

	measure '% Comentarios Capacitacion' = DIVIDE(CALCULATE(COUNTROWS(Fact_SatisfaccionCapacitacion), Fact_SatisfaccionCapacitacion[Comentario] <> "Sin comentario"), COUNTROWS(Fact_SatisfaccionCapacitacion))
		formatString: 0.0%
		lineageTag: b6305f66-fcab-42d1-b9ba-c304588f47f9

	measure 'Call Centers Capacitados' = DISTINCTCOUNT(Fact_SatisfaccionCapacitacion[CallCenter])
		formatString: 0
		lineageTag: 168f2d19-29c5-40f2-910e-584fbdfa912f

	measure 'Ultima Capacitacion' = MAX(Fact_SatisfaccionCapacitacion[Fecha])
		formatString: dd/MM/yyyy
		lineageTag: 80996b3c-a029-4e03-a476-950aa034cbe2

	measure 'Capacitaciones Realizadas' =
			COUNTROWS(
				SUMMARIZE(
					Fact_SatisfaccionCapacitacion,
					Fact_SatisfaccionCapacitacion[Fecha],
					Fact_SatisfaccionCapacitacion[CallCenter],
					Fact_SatisfaccionCapacitacion[NombreFormador]
				)
			)
		formatString: 0
		lineageTag: 997b82e9-8f18-4763-9055-4502bb675e9b

	measure 'Valor Metrica Satisfaccion' =
			SWITCH(
				SELECTEDVALUE(Dim_MetricaSatisfaccion[Metrica]),
				"Satisfacción", [Satisfaccion Promedio Capacitacion],
				"Claridad", [Claridad Promedio Capacitacion],
				"Utilidad", [Utilidad Promedio Capacitacion],
				"Dinamismo", [Dinamismo Promedio Capacitacion],
				BLANK()
			)
		formatString: 0.0
		lineageTag: 91dda347-10b6-4225-85b9-24a659d2977b

	measure 'Ultima Capacitacion Texto' =
			VAR Fecha = [Ultima Capacitacion]
			RETURN
				IF(
					ISBLANK(Fecha),
					BLANK(),
					FORMAT(DAY(Fecha), "00") & "/" & FORMAT(MONTH(Fecha), "00") & "/" & FORMAT(YEAR(Fecha), "0000")
				)
		lineageTag: 5e2fb000-13a0-4493-8be9-ad9c7ee5dd90

	column Columna1
		dataType: int64
		isHidden
		lineageTag: 83e907d2-3c42-4aa1-9158-30ed93e6869c
		summarizeBy: none
		sourceColumn: Columna1

	partition '_Medidas Capacitacion' = m
		mode: import
		source =
				let
					Origen = #table(type table[Columna1 = Int64.Type], {})
				in
					Origen

