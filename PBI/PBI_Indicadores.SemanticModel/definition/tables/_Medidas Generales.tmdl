table '_Medidas Generales'

	column Columna1
		isHidden
		dataType: int64
		summarizeBy: none
		sourceColumn: Columna1

	measure 'Total Evaluaciones Calidad' = COUNTROWS(Fact_CalidadLlamadas)
		formatString: 0

	measure 'Total Respuestas Capacitacion' = COUNTROWS(Fact_SatisfaccionCapacitacion)
		formatString: 0

	measure 'Total Respuestas Motivacion' = COUNTROWS(Fact_MotivacionActividad)
		formatString: 0

	measure 'Total Registros Piloto' = [Total Evaluaciones Calidad] + [Total Respuestas Capacitacion] + [Total Respuestas Motivacion]
		formatString: 0

	measure 'n Calidad' = "n=" & [Total Evaluaciones Calidad]

	measure 'n Capacitacion' = "n=" & [Total Respuestas Capacitacion]

	measure 'n Motivacion' = "n=" & [Total Respuestas Motivacion]

	partition '_Medidas Generales' = m
		mode: import
		source =
				let
					Origen = #table(type table[Columna1 = Int64.Type], {})
				in
					Origen
