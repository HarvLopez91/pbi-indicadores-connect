table Dim_Jornada
	lineageTag: ebe913b6-171b-481a-968e-3dce0a83cc79

	column Jornada
		dataType: string
		lineageTag: 0c452fe5-f47a-43c5-bc0e-2455144f594f
		summarizeBy: none
		sourceColumn: Jornada

	partition Dim_Jornada = m
		mode: import
		source =
				let
					ValoresCapacitacion = Table.SelectColumns(Fact_SatisfaccionCapacitacion, {"Jornada"}),
					ValoresMotivacion = Table.SelectColumns(Fact_MotivacionActividad, {"Jornada"}),
					ValoresUnidos = Table.Combine({ValoresCapacitacion, ValoresMotivacion}),
					SinNulos = Table.SelectRows(ValoresUnidos, each [Jornada] <> null),
					SinDuplicados = Table.Distinct(SinNulos),
					Ordenado = Table.Sort(SinDuplicados, {{"Jornada", Order.Ascending}}),
					TipoAplicado = Table.TransformColumnTypes(Ordenado, {{"Jornada", type text}})
				in
					TipoAplicado

