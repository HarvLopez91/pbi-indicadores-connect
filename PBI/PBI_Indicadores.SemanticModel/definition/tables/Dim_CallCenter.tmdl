table Dim_CallCenter
	lineageTag: 32f0b0f4-b526-4e5a-9357-32a6296e50a0

	column CallCenter
		dataType: string
		lineageTag: b15454d0-cfe7-43b8-be44-0c2f6a214cba
		summarizeBy: none
		sourceColumn: CallCenter

	partition Dim_CallCenter = m
		mode: import
		source =
				let
					ValoresCalidad = Table.SelectColumns(Fact_CalidadLlamadas, {"CallCenter"}),
					ValoresCapacitacion = Table.SelectColumns(Fact_SatisfaccionCapacitacion, {"CallCenter"}),
					ValoresMotivacion = Table.SelectColumns(Fact_MotivacionActividad, {"CallCenter"}),
					ValoresUnidos = Table.Combine({ValoresCalidad, ValoresCapacitacion, ValoresMotivacion}),
					SinNulos = Table.SelectRows(ValoresUnidos, each [CallCenter] <> null),
					SinDuplicados = Table.Distinct(SinNulos),
					Ordenado = Table.Sort(SinDuplicados, {{"CallCenter", Order.Ascending}}),
					TipoAplicado = Table.TransformColumnTypes(Ordenado, {{"CallCenter", type text}})
				in
					TipoAplicado

