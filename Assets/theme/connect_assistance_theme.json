{
  "name": "Connect Assistance",
  "dataColors": [
    "#F15B2B",
    "#002733",
    "#8A8A8A",
    "#F69475",
    "#A9401E",
    "#D9D9D9",
    "#3A3A3A",
    "#F9BDAA"
  ],
  "background": "#FFFFFF",
  "foreground": "#002733",
  "tableAccent": "#F15B2B",
  "secondaryBackground": "#F4F4F4",
  "firstLevelElements": "#002733",
  "secondLevelElements": "#3A3A3A",
  "thirdLevelElements": "#F4F4F4",
  "fourthLevelElements": "#8A8A8A",
  "good": "#2E8B57",
  "neutral": "#8A8A8A",
  "bad": "#C0392B",
  "maximum": "#F15B2B",
  "center": "#FBAF7C",
  "minimum": "#F4F4F4",
  "textClasses": {
    "title": {
      "color": "#002733",
      "fontSize": 14
    },
    "header": {
      "color": "#002733",
      "fontSize": 11
    },
    "callout": {
      "color": "#002733",
      "fontSize": 28
    },
    "label": {
      "color": "#3A3A3A",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#F4F4F4" } },
            "radius": 4
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#F15B2B" } },
            "radius": 4
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#002733" } },
            "fontSize": 28,
            "bold": true
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#3A3A3A" } },
            "fontSize": 11
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#F15B2B" } },
            "radius": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#002733" } },
            "background": { "solid": { "color": "#F4F4F4" } },
            "fontSize": 11
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#002733" } },
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": true
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#F15B2B" } }
          }
        ],
        "categoryAxis": [
          {
            "color": { "solid": { "color": "#3A3A3A" } }
          }
        ],
        "valueAxis": [
          {
            "color": { "solid": { "color": "#3A3A3A" } },
            "gridlineColor": { "solid": { "color": "#F4F4F4" } }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#F15B2B" } }
          }
        ],
        "categoryAxis": [
          {
            "color": { "solid": { "color": "#3A3A3A" } }
          }
        ],
        "valueAxis": [
          {
            "color": { "solid": { "color": "#3A3A3A" } },
            "gridlineColor": { "solid": { "color": "#F4F4F4" } }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#F15B2B" } }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#F15B2B" } }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": { "solid": { "color": "#F4F4F4" } },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "backColor": { "solid": { "color": "#002733" } },
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "bold": true,
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#002733" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": { "solid": { "color": "#F4F4F4" } },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "backColor": { "solid": { "color": "#002733" } },
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "bold": true,
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#002733" } },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#002733" } },
            "fontSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
